{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "side-u",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // 本番に出す前の版を、版ごとの URL（<版 ID の先頭 8 文字>-side-u.side-u.workers.dev）で試せるようにする
  "preview_urls": true,
  // DNS レコードと証明書は Cloudflare が自動で作る（perfumehub.app のゾーンが同じアカウントにあること）
  "routes": [{ "pattern": "sideu.perfumehub.app", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 共有ページ（メタデータの差し替え）と OGP 画像だけ Worker を通す。それ以外は静的配信（DESIGN.md §10）
    "run_worker_first": ["/u/*", "/og/*"]
  },
  "vars": {
    // "off" にすると動的 OGP を止め、共通の画像とメタデータを返す
    "OG_DYNAMIC": "on"
  },
  "observability": { "enabled": true }
}
