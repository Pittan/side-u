    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.58.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "jose": "^6.2.12",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11",
