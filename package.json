{
  "name": "side-u",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "catalog:import": "tsx scripts/import-perfume-database.ts",
